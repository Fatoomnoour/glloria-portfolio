# Glloria production environment
# Copy to .env locally and set real values outside source control.
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=

# Session signing and managed OAuth
JWT_SECRET=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Optional platform services
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
